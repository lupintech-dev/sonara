{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://sonara-g3cu.onrender.com/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://sonara-g3cu.onrender.com/uploads/:path*"
    },
    {
      "source": "/((?!api/|uploads/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
